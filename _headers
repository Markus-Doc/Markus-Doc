/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/docs/*
  Cache-Control: public, max-age=0, must-revalidate

/Markus_Walker_Resume.pdf
  Cache-Control: public, max-age=0, must-revalidate

https://:project.markus-doc.pages.dev/*
  X-Robots-Tag: noindex

https://markus-doc.pages.dev/*
  X-Robots-Tag: noindex

/atlas-preview/assets/*
  Cache-Control: public, max-age=31536000, immutable

/atlas-preview/data/*
  Cache-Control: public, max-age=0, must-revalidate

# AI Stack Check preview (renamed from the Atlas preview on 19 Oct 2026). Short cache while it changes daily.
/stack-check/assets/*
  Cache-Control: public, max-age=300, must-revalidate

/stack-check/data/*
  Cache-Control: public, max-age=0, must-revalidate

# BEGIN readiness-check (managed by tools/publish_site.py, edit there)
/readiness-check/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex

/readiness-check/
  Cache-Control: no-cache

/readiness-check/index.html
  Cache-Control: no-cache

/readiness-check/landscape.html
  Cache-Control: no-cache

/readiness-check/css/*
  Cache-Control: public, max-age=300, must-revalidate

/readiness-check/js/*
  Cache-Control: public, max-age=300, must-revalidate

/readiness-check/vendor/*
  Cache-Control: public, max-age=300, must-revalidate

/readiness-check/data/*
  Cache-Control: public, max-age=0, must-revalidate
# END readiness-check
