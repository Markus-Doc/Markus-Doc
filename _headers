/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/docs/*
  Cache-Control: public, max-age=0, must-revalidate

/Markus_Walker_Resume.pdf
  Cache-Control: public, max-age=0, must-revalidate

https://:project.markus-doc.pages.dev/*
  X-Robots-Tag: noindex

https://markus-doc.pages.dev/*
  X-Robots-Tag: noindex

# AI Stack Check (offerings-atlas), released 19 Oct 2026. Short cache while the data refreshes daily.
/stack-check/assets/*
  Cache-Control: public, max-age=300, must-revalidate
  Cross-Origin-Resource-Policy: same-origin

/stack-check/data/*
  Cache-Control: public, max-age=0, must-revalidate
  Cross-Origin-Resource-Policy: same-origin

/stack-check/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

# BEGIN readiness-check (managed by tools/publish_site.py, edit there)
/readiness-check/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex

/readiness-check/
  Cache-Control: no-cache

/readiness-check/index.html
  Cache-Control: no-cache

/readiness-check/landscape.html
  Cache-Control: no-cache

/readiness-check/*.html
  Cache-Control: no-cache

/readiness-check/css/*
  Cache-Control: public, max-age=0, must-revalidate

/readiness-check/js/*
  Cache-Control: public, max-age=0, must-revalidate

/readiness-check/vendor/*
  Cache-Control: public, max-age=0, must-revalidate

/readiness-check/assets/*
  Cache-Control: public, max-age=86400

/readiness-check/data/*
  Cache-Control: public, max-age=0, must-revalidate
# END readiness-check

# BEGIN company (company home page, at /checkable-ai/ since 22 Oct 2026, added 21 Oct 2026)
/checkable-ai/*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/checkable-ai/
  Cache-Control: no-cache

/checkable-ai/index.html
  Cache-Control: no-cache

/checkable-ai/company.css
  Cache-Control: public, max-age=0, must-revalidate

/checkable-ai/nav.js
  Cache-Control: public, max-age=0, must-revalidate

/checkable-ai/tools-slider.js
  Cache-Control: public, max-age=0, must-revalidate

/checkable-ai/liquid-glass.js
  Cache-Control: public, max-age=0, must-revalidate
# END company

# BEGIN site-art (feature image library and ?art preview switcher, added 22 Oct 2026; source: private repo Markus-Doc/site-art)
/site-art/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: same-origin

/site-art/rotator.js
  Cache-Control: public, max-age=0, must-revalidate
# END site-art
